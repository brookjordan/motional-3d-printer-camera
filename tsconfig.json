{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "outDir": "data/js",
    "rootDir": "src/js",
    "lib": ["ES2022", "DOM"]
  },
  "include": ["src/js/**/*"],
  "exclude": ["node_modules", "data"]
}